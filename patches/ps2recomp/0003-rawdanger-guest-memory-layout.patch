+// Upstream pool addresses live at 0x01F00000..0x01F31000. A game module may move
+// the whole block (same relative layout) via ps2x_hooks::runtimePoolBase.
+static inline uint32_t runtimePoolAddr(uint32_t upstreamAddr)
+{
+    const uint32_t base = ps2x_hooks::hooks().runtimePoolBase;
+    return base ? base + (upstreamAddr - kRpcPacketPoolBase) : upstreamAddr;
+}
