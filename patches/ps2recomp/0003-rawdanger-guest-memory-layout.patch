@@ -28,6 +28,19 @@ namespace ps2x_hooks
         // Host display aspect ratio for the presented frame (e.g. 4/3 or 16/9).
         // 0 keeps the runtime default (square-pixel scaling of the framebuffer).
         float presentAspect = 0.0f;
+
+        // ---- guest memory layout (0 = upstream defaults) -------------------
+        // Upstream keeps runtime-owned guest memory in the top 1 MB of RAM
+        // (RPC/TLS/boot pools at 0x01F00000, interrupt-callback stacks carved
+        // down from 0x02000000) and caps the guest heap at 0x01F00000. Games
+        // that size their own heap to "all RAM below my stack" (Raw Danger:
+        // stack 0x01FE8000-0x02000000, heap ~24.4 MB in one memalign) collide
+        // with that. These let a game module move runtime memory into the EE
+        // kernel area (0x00000000-0x00080000), which the HLE kernel leaves free.
+        uint32_t guestHeapHardLimit = 0u; // heap end, exclusive (default 0x01F00000)
+        uint32_t runtimePoolBase = 0u;    // RPC packet/server, TLS, boot pools: 0x31000 bytes (default 0x01F00000)
+        uint32_t asyncStackTop = 0u;      // interrupt-callback stacks grow down from here...
+        uint32_t asyncStackFloor = 0u;    // ...to here (default: from 0x02000000 down to the heap limit)
     };
 
     inline Hooks &hooks()
@@ -47,6 +60,15 @@ namespace ps2x_hooks
         hooks().presentAspect = aspect;
     }
 
+    inline void setGuestMemoryLayout(uint32_t heapHardLimit, uint32_t poolBase,
+                                     uint32_t asyncTop, uint32_t asyncFloor)
+    {
+        hooks().guestHeapHardLimit = heapHardLimit;
+        hooks().runtimePoolBase = poolBase;
+        hooks().asyncStackTop = asyncTop;
+        hooks().asyncStackFloor = asyncFloor;
+    }
