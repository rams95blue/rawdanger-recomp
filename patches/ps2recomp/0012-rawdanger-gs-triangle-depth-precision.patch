+        tc.Run("GS triangle at Z 0xFFFFFF00 passes ZTST GEQUAL against an equal Z buffer everywhere", [](TestCase &t)
+        {
+            // Raw Danger's title screen: full-screen 2D quads (two triangles) at
+            // Z = 0xFFFFFF00 with XYOFFSET 1728/1824, ZTST GEQUAL, Z buffer
+            // holding 0xFFFFFF00.
+            std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+            GS gs;
+            gs.init(vram.data(), static_cast<uint32_t>(vram.size()), nullptr);
+
+            constexpr uint32_t kZ = 0xFFFFFF00u;
+            constexpr uint32_t kW = 640u, kH = 448u, kFbw = 10u;
+            constexpr uint32_t kZbp = 0x118u; // pages
+            for (uint32_t y = 0; y < kH; ++y)
+                for (uint32_t x = 0; x < kW; ++x)
+                    gs.WriteVram(GS_PSM_Z32, kZbp * 32u, kFbw, x, y, kZ);
+
+            gs.writeRegister(GS_REG_FRAME_1, (static_cast<uint64_t>(kFbw) << 16) | (static_cast<uint64_t>(GS_PSM_CT32) << 24));
+            gs.writeRegister(GS_REG_ZBUF_1, static_cast<uint64_t>(kZbp) | (1ull << 32)); // Z32, ZMSK
+            gs.writeRegister(GS_REG_SCISSOR_1, (static_cast<uint64_t>(kW - 1u) << 16) | (static_cast<uint64_t>(kH - 1u) << 48));
+            gs.writeRegister(GS_REG_XYOFFSET_1, 0x6C00ull | (0x7200ull << 32));
+            gs.writeRegister(GS_REG_TEST_1, (1ull << 16) | (2ull << 17)); // ZTE, ZTST = GEQUAL
+            gs.writeRegister(GS_REG_PRIM, static_cast<uint64_t>(GS_PRIM_TRIANGLE));
+            gs.writeRegister(GS_REG_RGBAQ, 0x80FFFFFFull);
+
+            auto xyz = [&](uint32_t x, uint32_t y) -> uint64_t
+            {
+                return static_cast<uint64_t>((1728u + x) * 16u) | (static_cast<uint64_t>((1824u + y) * 16u) << 16) |
+                       (static_cast<uint64_t>(kZ) << 32);
+            };
+            gs.writeRegister(GS_REG_XYZ2, xyz(0u, 0u));
+            gs.writeRegister(GS_REG_XYZ2, xyz(kW, 0u));
+            gs.writeRegister(GS_REG_XYZ2, xyz(0u, kH));
+            gs.writeRegister(GS_REG_XYZ2, xyz(kW, 0u));
+            gs.writeRegister(GS_REG_XYZ2, xyz(0u, kH));
+            gs.writeRegister(GS_REG_XYZ2, xyz(kW, kH));
+
+            uint32_t missed = 0u;
+            for (uint32_t y = 1; y + 1 < kH; ++y)
+                for (uint32_t x = 1; x + 1 < kW; ++x)
+                    if (readReferencePSMCT32Pixel(vram, 0u, kFbw, x, y) != 0x80FFFFFFu)
+                        ++missed;
+            t.Equals(missed, 0u, "every pixel of a constant-Z quad should pass GEQUAL against the same Z");
+        });
