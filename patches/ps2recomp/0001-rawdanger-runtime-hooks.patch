diff --git a/ps2xRuntime/include/ps2x_hooks.h b/ps2xRuntime/include/ps2x_hooks.h
new file mode 100644
index 0000000..84f3c75
--- /dev/null
+++ b/ps2xRuntime/include/ps2x_hooks.h
@@ -0,0 +1,55 @@
+#pragma once
+
+// Game-module hooks (added by the Raw Danger recomp project patch).
+// Header-only so no build-system change is needed. A game override installs
+// these from its apply callback; the runtime consults them on CD access.
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+namespace ps2x_hooks
+{
+    // Return true if the hook filled dst (byteCount bytes) for this LBN range.
+    using CdSectorReadFn = bool (*)(uint32_t lbn, uint32_t sectors, uint8_t *dst, size_t byteCount, void *user);
+
+    // Called when a cdrom0: path is resolved to a host file. Return true and set
+    // out to serve a different host file (e.g. a Japanese voice archive).
+    using CdHostPathFn = bool (*)(const std::string &ps2Path, const std::filesystem::path &resolved,
+                                  std::filesystem::path &out, void *user);
+
+    struct Hooks
+    {
+        CdSectorReadFn cdSectorRead = nullptr;
+        void *cdSectorReadUser = nullptr;
+        CdHostPathFn cdHostPath = nullptr;
+        void *cdHostPathUser = nullptr;
+        // Host display aspect ratio for the presented frame (e.g. 4/3 or 16/9).
+        // 0 keeps the runtime default (square-pixel scaling of the framebuffer).
+        float presentAspect = 0.0f;
+    };
+
+    inline Hooks &hooks()
+    {
+        static Hooks instance;
+        return instance;
+    }
+
+    inline void setCdSectorReadHook(CdSectorReadFn fn, void *user)
+    {
+        hooks().cdSectorRead = fn;
+        hooks().cdSectorReadUser = user;
+    }
+
+    inline void setPresentAspect(float aspect)
+    {
+        hooks().presentAspect = aspect;
+    }
+
+    inline void setCdHostPathHook(CdHostPathFn fn, void *user)
+    {
+        hooks().cdHostPath = fn;
+        hooks().cdHostPathUser = user;
+    }
+}
