+
+    int32_t IopIoman::open(uint32_t pathAddress, uint32_t flags)
+    {
+        const std::string guestPath = m_memory.readString(pathAddress, 256u);
+        if (guestPath.empty())
+            return -kEINVAL;
+        if ((flags & kOpenAccessMask) != kOpenReadOnly)
+        {
+            m_host.log(LogLevel::Warning, "[IOP ioman] open(\"" + guestPath + "\") for writing is not supported");
+            return -kEACCES;
+        }
+        if (m_files.size() >= kMaxFiles)
+            return -kEMFILE;
+
+        const std::string hostPath = m_host.translateGuestPath(guestPath);
+        const uint64_t handle = hostPath.empty() ? 0u : m_host.openHostFile(hostPath);
+        if (handle == 0u)
+        {
+            m_host.log(LogLevel::Warning, "[IOP ioman] open(\"" + guestPath + "\") failed" +
+                                              (hostPath.empty() ? std::string(" (no host path)") : " (" + hostPath + ")"));
+            return -kENOENT;
+        }
+        uint64_t size = 0u;
+        (void)m_host.hostFileSize(handle, size);
+
+        int32_t fd = m_nextFd;
+        while (m_files.count(fd) != 0u)
+            fd = fd >= 0x7FFF ? 3 : fd + 1;
+        m_nextFd = fd >= 0x7FFF ? 3 : fd + 1;
+        m_files[fd] = File{handle, size, 0u, guestPath};
+
+        std::ostringstream out;
+        out << "[IOP ioman] open(\"" << guestPath << "\") -> fd " << fd << " (" << size << " bytes)";
+        m_host.log(LogLevel::Debug, out.str());
+        return fd;
+    }
+
+    int32_t IopIoman::close(int32_t fd)
+    {
+        const auto it = m_files.find(fd);
+        if (it == m_files.end())
+            return -kEBADF;
+        if (it->second.handle != 0u)
+            m_host.closeHostFile(it->second.handle);
+        m_files.erase(it);
+        return 0;
+    }
+
+    int32_t IopIoman::read(int32_t fd, uint32_t buffer, uint32_t size)
+    {
+        const auto it = m_files.find(fd);
+        if (it == m_files.end())
+            return -kEBADF;
+        File &file = it->second;
+        if (static_cast<int32_t>(size) < 0)
+            return -kEINVAL;
+        const uint64_t available = file.position < file.size ? file.size - file.position : 0u;
+        uint32_t remaining = static_cast<uint32_t>(std::min<uint64_t>(size, available));
+
+        std::vector<uint8_t> chunk;
+        uint32_t done = 0u;
+        while (remaining != 0u)
+        {
+            const uint32_t wanted = std::min(remaining, kReadChunk);
+            chunk.resize(wanted);
+            size_t got = 0u;
+            if (!m_host.readHostFile(file.handle, file.position, chunk.data(), wanted, got))
+                return done != 0u ? static_cast<int32_t>(done) : -kEIO;
+            if (got == 0u)
+                break;
+            if (!m_memory.writeRam(buffer + done, chunk.data(), got))
+                return done != 0u ? static_cast<int32_t>(done) : -kEINVAL;
+            file.position += got;
+            done += static_cast<uint32_t>(got);
+            remaining -= static_cast<uint32_t>(got);
+            if (got < wanted)
+                break;
+        }
+        return static_cast<int32_t>(done);
+    }
+
+    int32_t IopIoman::write(int32_t fd, uint32_t buffer, uint32_t size)
+    {
+        if (fd == 1 || fd == 2)
+        {
+            std::string text(std::min<uint32_t>(size, 4096u), '\0');
+            if (!m_memory.readRam(buffer, text.data(), text.size()))
+                return -kEINVAL;
+            while (!text.empty() && (text.back() == '\n' || text.back() == '\0'))
+                text.pop_back();
+            m_host.log(LogLevel::Info, "[IOP stdout] " + text);
+            return static_cast<int32_t>(size);
+        }
+        return m_files.count(fd) != 0u ? -kEACCES : -kEBADF;
+    }
+
+    int32_t IopIoman::lseek(int32_t fd, int32_t offset, uint32_t whence)
+    {
+        const auto it = m_files.find(fd);
+        if (it == m_files.end())
+            return -kEBADF;
+        File &file = it->second;
+        int64_t base = 0;
+        switch (whence)
+        {
+        case 0: base = 0; break;                                       // SEEK_SET
+        case 1: base = static_cast<int64_t>(file.position); break;     // SEEK_CUR
+        case 2: base = static_cast<int64_t>(file.size); break;         // SEEK_END
+        default: return -kEINVAL;
+        }
+        const int64_t target = base + offset;
+        if (target < 0 || target > 0x7FFFFFFFLL)
+            return -kEINVAL;
+        file.position = static_cast<uint64_t>(target);
+        return static_cast<int32_t>(target);
     }
 
