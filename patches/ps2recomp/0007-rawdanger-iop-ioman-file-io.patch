+    void IopIoman::closeAll()
+    {
+        for (auto &[fd, file] : m_files)
+        {
+            (void)fd;
+            if (file.handle != 0u)
+                m_host.closeHostFile(file.handle);
+        }
+        m_files.clear();
+        m_nextFd = 3;
