+    // Serves "cdrom0:\\NAME;1" from a host directory with real files.
+    class FileHost final : public NullHost
+    {
+    public:
+        explicit FileHost(std::filesystem::path rootPath) : root(std::move(rootPath)) {}
+        ~FileHost() override
+        {
+            for (auto &[h, f] : files)
+                std::fclose(f);
+        }
+        std::string translateGuestPath(std::string_view path) const override
+        {
+            std::string p(path);
+            const auto colon = p.find(':');
+            if (colon == std::string::npos || p.compare(0, colon, "cdrom0") != 0)
+                return {};
+            p = p.substr(colon + 1);
+            if (const auto semi = p.find(';'); semi != std::string::npos)
+                p.resize(semi);
+            while (!p.empty() && (p[0] == '\\' || p[0] == '/'))
+                p.erase(0, 1);
+            for (char &c : p)
+                if (c == '\\')
+                    c = '/';
+            return (root / p).string();
+        }
+        uint64_t openHostFile(std::string_view path) override
+        {
+            std::FILE *f = std::fopen(std::string(path).c_str(), "rb");
+            if (!f)
+                return 0u;
+            files[++next] = f;
+            ++opened;
+            return next;
+        }
+        bool hostFileSize(uint64_t h, uint64_t &size) const override
+        {
+            const auto it = files.find(h);
+            if (it == files.end())
+                return false;
+            const long cur = std::ftell(it->second);
+            std::fseek(it->second, 0, SEEK_END);
+            size = static_cast<uint64_t>(std::ftell(it->second));
+            std::fseek(it->second, cur, SEEK_SET);
+            return true;
+        }
+        bool readHostFile(uint64_t h, uint64_t offset, void *dst, size_t size, size_t &got) override
+        {
+            got = 0u;
+            const auto it = files.find(h);
+            if (it == files.end() || std::fseek(it->second, static_cast<long>(offset), SEEK_SET) != 0)
+                return false;
+            got = std::fread(dst, 1, size, it->second);
+            return true;
+        }
+        void closeHostFile(uint64_t h) override
+        {
+            const auto it = files.find(h);
+            if (it != files.end())
+            {
+                std::fclose(it->second);
+                files.erase(it);
+            }
+        }
+        std::filesystem::path root;
+        std::map<uint64_t, std::FILE *> files;
+        uint64_t next = 0u;
+        int opened = 0;
+    };
