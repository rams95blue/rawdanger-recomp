+    // The open / lseek / read-in-chunks / close sequence IREMSND2 (Raw Danger's
+    // sound driver) uses to stream sound banks from cdrom0:.
+    bool testIomanFileIo()
+    {
+        const auto suffix = std::to_string(
+            static_cast<unsigned long long>(std::chrono::steady_clock::now().time_since_epoch().count()));
+        const std::filesystem::path root = std::filesystem::temp_directory_path() / ("ps2x-iop-ioman-" + suffix);
+        std::error_code error;
+        std::filesystem::create_directories(root / "SE", error);
+        std::vector<uint8_t> data(300000u);
+        for (size_t i = 0; i < data.size(); ++i)
+            data[i] = static_cast<uint8_t>(i * 7u + (i >> 9));
+        {
+            std::ofstream f(root / "SE" / "COMMON.BD", std::ios::binary);
+            f.write(reinterpret_cast<const char *>(data.data()), static_cast<std::streamsize>(data.size()));
+        }
+
+        bool ok = true;
+        {
+            FileHost host(root);
+            IopMemory memory;
+            RecordingExecutor executor;
+            IopIoman ioman(host, memory);
+            ioman.reset();
+            const auto call = [&](uint16_t ordinal, uint32_t a0, uint32_t a1, uint32_t a2)
+            {
+                IopCpuState cpu{};
+                cpu.gpr[4] = a0;
+                cpu.gpr[5] = a1;
+                cpu.gpr[6] = a2;
+                ok = expect(ioman.dispatchImport(ordinal, cpu, executor), "ioman import not handled") && ok;
+                return static_cast<int32_t>(cpu.gpr[2]);
+            };
+            constexpr uint32_t pathAddress = 0x2000u;
+            constexpr uint32_t buffer = 0x40000u;
+            const char path[] = "cdrom0:\\SE\\COMMON.BD;1";
+            (void)memory.writeRam(pathAddress, path, sizeof(path));
+
+            const int32_t fd = call(4, pathAddress, 1u, 0x1FFu);
+            ok = expect(fd >= 3, "open did not return a descriptor") && ok;
+            ok = expect(call(8, static_cast<uint32_t>(fd), 0x1000u, 0u) == 0x1000, "lseek SEEK_SET") && ok;
+            // read in 0x8000-byte chunks like IREMSND2's loop, past the end of the file
+            uint32_t total = 0u;
+            for (int guard = 0; guard < 64; ++guard)
+            {
+                const int32_t got = call(6, static_cast<uint32_t>(fd), buffer + total, 0x8000u);
+                ok = expect(got >= 0, "read failed") && ok;
+                if (got <= 0)
+                    break;
+                total += static_cast<uint32_t>(got);
+            }
+            ok = expect(total == data.size() - 0x1000u, "read did not stop at end of file") && ok;
+            std::vector<uint8_t> back(total);
+            ok = expect(memory.readRam(buffer, back.data(), back.size()), "IOP RAM readback") && ok;
+            ok = expect(std::memcmp(back.data(), data.data() + 0x1000, total) == 0, "read returned the wrong bytes") && ok;
+            ok = expect(call(8, static_cast<uint32_t>(fd), 0u, 2u) == static_cast<int32_t>(data.size()), "lseek SEEK_END") && ok;
+            ok = expect(call(8, static_cast<uint32_t>(fd), static_cast<uint32_t>(-16), 1u) ==
+                            static_cast<int32_t>(data.size()) - 16, "lseek SEEK_CUR") && ok;
+            ok = expect(call(5, static_cast<uint32_t>(fd), 0u, 0u) == 0, "close") && ok;
+            ok = expect(call(5, static_cast<uint32_t>(fd), 0u, 0u) == -9, "double close must be EBADF") && ok;
+            ok = expect(call(6, static_cast<uint32_t>(fd), buffer, 16u) == -9, "read after close must be EBADF") && ok;
+
+            const char missing[] = "cdrom0:\\SE\\NOPE.BD;1";
+            (void)memory.writeRam(pathAddress, missing, sizeof(missing));
+            ok = expect(call(4, pathAddress, 1u, 0x1FFu) == -2, "missing file must be ENOENT") && ok;
+            (void)memory.writeRam(pathAddress, path, sizeof(path));
+            ok = expect(call(4, pathAddress, 0x202u, 0x1FFu) == -13, "write open must be refused") && ok;
+            ok = expect(host.files.empty(), "host handles leaked") && ok;
+
+            // reset() closes anything still open
+            const int32_t fd2 = call(4, pathAddress, 1u, 0u);
+            ok = expect(fd2 >= 3 && host.files.size() == 1u, "reopen") && ok;
+            ioman.reset();
+            ok = expect(host.files.empty(), "reset did not close open files") && ok;
+        }
+        std::filesystem::remove_all(root, error);
+        return ok;
+    }
+}
