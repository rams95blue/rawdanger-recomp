+        const uint32_t offs[4] = {0u, 4u, 8u, 12u};
+        const uint8_t bits[4] = {0x8, 0x4, 0x2, 0x1};
+        for (int i = 0; i < 4; ++i)
+            if (f & bits[i])
+                out += fmt::format("WRITE32(0x11004000u + (((uint32_t)ctx->vi[{}] & 0xFFu) << 4) + {}u, (uint32_t)ctx->vi[{}]); ", inst.rd, offs[i], inst.rt);
+        return out + "}";
     }
 
