+            auto make = [](uint32_t op) {
+                Instruction inst{};
+                inst.opcode = OPCODE_COP2;
+                inst.rs = COP2_CO | 0x4;
+                inst.rt = 4;
+                inst.rd = 1;
+                inst.function = 0x3C;
+                inst.vectorInfo.vectorField = 0xF;
+                inst.raw = (((op >> 2) & 0x1F) << 6) | (op & 0x3);
+                return inst;
+            };
