+namespace
+{
+    // Row-band worker pool for the CPU rasterizer (Raw Danger recomp, patch
+    // 0013). One primitive's pixels are independent of each other (each is
+    // written once, reading only its own framebuffer/Z value), so a large
+    // sprite or triangle is split into horizontal bands drawn in parallel.
+    // Primitives still run one after another, in order.
+    class RasterPool
+    {
+    public:
+        static RasterPool &instance()
+        {
+            static RasterPool pool;
+            return pool;
+        }
+
+        unsigned workers() const { return static_cast<unsigned>(m_threads.size()) + 1u; }
+
+        void run(int y0, int y1, const std::function<void(int, int)> &fn)
+        {
+            const int rows = y1 - y0 + 1;
+            const int bands = std::min<int>(rows, static_cast<int>(workers()));
+            if (bands <= 1)
+            {
+                fn(y0, y1);
+                return;
+            }
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_fn = &fn;
+                m_y0 = y0;
+                m_y1 = y1;
+                m_bands = bands;
+                m_nextBand = 1; // band 0 runs on the calling thread
+                m_pending = bands - 1;
+                ++m_epoch;
+            }
+            m_wake.notify_all();
+            runBand(0);
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_done.wait(lock, [&] { return m_pending == 0; });
+            m_fn = nullptr;
+        }
+
+    private:
+        RasterPool()
+        {
+            unsigned n = std::thread::hardware_concurrency();
+            if (const char *env = std::getenv("PS2_GS_THREADS"))
+                n = static_cast<unsigned>(std::max(1, std::atoi(env)));
+            n = std::clamp(n, 1u, 32u);
+            for (unsigned i = 1; i < n; ++i)
+                m_threads.emplace_back([this] { workerLoop(); });
+        }
+
+        ~RasterPool()
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_quit = true;
+            }
+            m_wake.notify_all();
+            for (auto &t : m_threads)
+                t.join();
+        }
+
+        void runBand(int band)
+        {
+            const int rows = m_y1 - m_y0 + 1;
+            const int begin = m_y0 + (rows * band) / m_bands;
+            const int end = m_y0 + (rows * (band + 1)) / m_bands - 1;
+            if (begin <= end)
+                (*m_fn)(begin, end);
+        }
+
+        void workerLoop()
+        {
+            uint64_t seen = 0;
+            for (;;)
+            {
+                int band = -1;
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_wake.wait(lock, [&] { return m_quit || (m_epoch != seen && m_nextBand < m_bands); });
+                    if (m_quit)
+                        return;
+                    band = m_nextBand++;
+                    if (m_nextBand >= m_bands)
+                        seen = m_epoch;
+                }
+                runBand(band);
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    if (--m_pending == 0)
+                        m_done.notify_one();
+                }
+            }
+        }
+
+        std::vector<std::thread> m_threads;
+        std::mutex m_mutex;
+        std::condition_variable m_wake;
+        std::condition_variable m_done;
+        const std::function<void(int, int)> *m_fn = nullptr;
+        int m_y0 = 0, m_y1 = 0, m_bands = 0, m_nextBand = 0, m_pending = 0;
+        uint64_t m_epoch = 0;
+        bool m_quit = false;
+    };
+
+    // Generations are unique across all backend instances: a backend
+    // allocated at a destroyed one's address must not reuse its thread caches.
+    std::atomic<uint64_t> g_textureCacheGeneration{1};
+}
+
+static uint64_t nextTextureCacheGeneration()
+{
+    return g_textureCacheGeneration.fetch_add(1, std::memory_order_acq_rel) + 1u;
+}
+
+namespace
+{
+    struct ThreadTextureCache
+    {
+        GSMem::TexturePageCache cache;
+        uint64_t generation = 0;
+    };
+}
+
+void GSCpuBackend::ForEachRowBand(int y0, int y1, uint64_t pixelCount, const std::function<void(int, int)> &fn)
+{
+    if (y1 < y0)
+        return;
+    constexpr uint64_t kParallelMinPixels = 8192u;
+    if (pixelCount < kParallelMinPixels || (y1 - y0) < 8)
+    {
+        fn(y0, y1);
+        return;
+    }
+    RasterPool::instance().run(y0, y1, fn);
+}
