+    // Each rasterizer thread keeps its own single-page cache; a TEXFLUSH or
+    // reset (generation bump) drops it the same way it drops the shared one.
+    thread_local ThreadTextureCache tls;
+    const uint64_t generation = m_textureCacheGeneration.load(std::memory_order_acquire);
+    if (tls.generation != generation)
+    {
+        tls.cache.Invalidate();
+        tls.generation = generation;
+    }
+    return GSMem::ReadTexture(tls.cache, m_vram, psm, base, bw, x, y);
