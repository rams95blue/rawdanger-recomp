+// rawdanger-recomp: Raw Danger's colour filter in one pass (gs.cpp, rdfilter: the formula and how it was checked). Params: 0 frame
+// bp, 1 bw, 2 width, 3 height, 4 depth bp, 5 depth psm, 6 brightness palette, 7-9 its weights (B, G, R), 10 / 11 the depth
+// palettes, 12-15 the palettes of the four writes. Palettes: 256 entries of 32 bits, CSM1, read from sample 0.
+fn rd_entry(cbp: u32, i: u32) -> u32 {
+    let j = (i & 0xE7u) | ((i & 8u) << 1u) | ((i & 0x10u) >> 1u);
+    return read_pixel(0u, cbp, 1u, j % 16u, j / 16u);
+}
+
+fn rd_g(v: u32) -> i32 {
+    return i32((v >> 8u) & 255u);
+}
+
+@compute @workgroup_size(64)
+fn game_filter(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let i = gid.x + gid.y * 64u * 1024u;
+    let n = SCALE * SCALE;
+    let w = prm(2u);
+    if (i >= w * prm(3u) * n) {
+        return;
+    }
+    let k = i % n;
+    let x = (i / n) % w;
+    let y = (i / n) / w;
+    let fl = locate(0u, prm(0u), prm(1u), x, y);
+    let c = load_at(fl, k);
+    let z = read_sample(prm(5u), prm(4u), prm(1u), x, y, k);
+    var l = 0;
+    l = min(255, l + ((rd_g(rd_entry(prm(6u), (c >> 16u) & 255u)) * i32(prm(7u))) >> 7u));
+    l = min(255, l + ((rd_g(rd_entry(prm(6u), (c >> 8u) & 255u)) * i32(prm(8u))) >> 7u));
+    l = min(255, l + ((rd_g(rd_entry(prm(6u), c & 255u)) * i32(prm(9u))) >> 7u));
+    let d = u32(min(255, rd_g(rd_entry(prm(10u), (z >> 16u) & 255u)) + rd_g(rd_entry(prm(11u), (z >> 8u) & 255u))));
+    let a1 = i32(rd_entry(prm(12u), d) >> 24u);
+    let a2 = rd_entry(prm(14u), d) >> 24u;
+    let s1 = rd_entry(prm(13u), u32(l));
+    let s2 = rd_entry(prm(15u), u32(l));
+    var out = a2 << 24u;
+    for (var b = 0u; b < 3u; b = b + 1u) {
+        let xv = i32((c >> (8u * b)) & 255u);
+        let x1 = clamp(((i32((s1 >> (8u * b)) & 255u) - xv) * a1 >> 7u) + xv, 0, 255);
+        let x2 = clamp(((i32((s2 >> (8u * b)) & 255u) * i32(a2)) >> 7u) + x1, 0, 255);
+        out = out | (u32(x2) << (8u * b));
+    }
+    store(fl, k, out);
+}
