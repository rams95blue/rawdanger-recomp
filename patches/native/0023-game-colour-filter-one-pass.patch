+// rawdanger-recomp: Raw Danger's colour filter in one pass (PS2_GAME_FILTER_PASS=1; docs/GRAPHICS.md, "The game's colour filter").
+// After its bloom the game walks the finished frame one 64 x 32 page at a time: per page about twenty small draws into 64-wide
+// scratch buffers (the page's depth and colour copied as 16-bit, read back byte by byte through palettes, added up) and four
+// writes back through more palettes. Worked out from them, and checked against the game's own result to the last bit on every
+// pixel (software renderer, a whole gameplay frame):
+//   L  = brightness: P_luma[B].g * w0 >> 7, + P_luma[G].g * w1 >> 7, + P_luma[R].g * w2 >> 7 (each sum held at 255)
+//   d  = min(255, P_dset[z byte 2].g + P_dadd[z byte 1].g)                     (the depth, through two palettes)
+//   c1 = c + ((P_mix[L].c - c) * P_mixa[d].a >> 7)                             (towards a curve of the brightness)
+//   c2 = min(255, c1 + (P_add[L].c * P_adda[d].a >> 7)), alpha P_adda[d].a     (the haze, by depth)
+// About 2,800 draws a frame, each reading what the one before wrote (2,065 GPU runs a frame instead of about 100): here they are
+// left out, their palettes and weights noted as they pass (the game builds the palettes each frame from its scene presets), and
+// the formula runs once over the frame at the end of the walk (every sample at any internal resolution).
+namespace rdfilter {
+const bool g_on = [] { const char *v = std::getenv("PS2_GAME_FILTER_PASS"); return v && *v == '1'; }();
+struct Walk {
+    bool active = false;
+    std::uint32_t zbp = 0, zpsm = 0x30, luma = 0, dset = 0, dadd = 0, fin[4] = {}, first_page = 0, pages = 0;
+    std::uint32_t weights[3] = {};
+    int nweights = 0, nfin = 0;
+    std::uint32_t alpha_writes = 0;
+} g_walk;
+std::uint32_t g_last_bp[8] = {}, g_last_bw[8] = {};   // the widths of the last few buffers drawn into (the frame's is not in the walk)
+int g_last_n = 0;
+
+std::uint32_t entry(std::uint32_t cbp, std::uint32_t i) {   // palette entry i of a 256-entry 32-bit palette stored at cbp (CSM1)
+    const std::uint32_t j = (i & 0xE7u) | ((i & 8u) << 1) | ((i & 0x10u) >> 1);
+    return read_pixel(0x00, cbp, 1, j % 16u, j / 16u);
+}
+
+// the formula on one pixel (shared with the GPU pass in gs.wgsl, game_filter)
+std::uint32_t apply(const Walk &w, std::uint32_t c, std::uint32_t z, const std::uint32_t *luma, const std::uint32_t *dset, const std::uint32_t *dadd,
+                    const std::uint32_t *const *fin) {
+    const auto g = [](std::uint32_t v) { return static_cast<int>((v >> 8) & 255u); };
+    const int ch[3] = {static_cast<int>((c >> 16) & 255u), static_cast<int>((c >> 8) & 255u), static_cast<int>(c & 255u)};   // B, G, R
+    int L = 0;
+    for (int k = 0; k < 3; ++k) L = std::min(255, L + ((g(luma[ch[k]]) * static_cast<int>(w.weights[k])) >> 7));
+    const int d = std::min(255, g(dset[(z >> 16) & 255u]) + g(dadd[(z >> 8) & 255u]));
+    const int a1 = static_cast<int>(fin[0][d] >> 24), a2 = static_cast<int>(fin[2][d] >> 24);
+    std::uint32_t out = static_cast<std::uint32_t>(a2) << 24;
+    for (int k = 0; k < 3; ++k) {
+        const int x = static_cast<int>((c >> (8 * k)) & 255u);
+        const int s1 = static_cast<int>((fin[1][L] >> (8 * k)) & 255u), s2 = static_cast<int>((fin[3][L] >> (8 * k)) & 255u);
+        const int x1 = std::clamp(((s1 - x) * a1 >> 7) + x, 0, 255);
+        const int x2 = std::clamp(((s2 * a2) >> 7) + x1, 0, 255);
+        out |= static_cast<std::uint32_t>(x2) << (8 * k);
+    }
+    return out;
+}
+
+void finish() {
+    Walk &w = g_walk;
+    if (!w.active) return;
+    w.active = false;
+    std::uint32_t bw = 0;
+    for (int i = 0; i < std::min(g_last_n, 8); ++i)
+        if (g_last_bp[i] == w.first_page) bw = g_last_bw[i];
+    static int told = 0;
+    if (!bw || !w.pages || w.pages % bw || w.nweights != 3 || w.nfin != 4 || !w.luma || !w.dset || !w.dadd) {
+        if (told++ < 3) std::fprintf(stderr, "[gs] the game's colour filter: an unknown walk (%u pages, width %u, %d weights, %d writes), left out\n", w.pages, bw, w.nweights, w.nfin);
+        return;
+    }
+    const std::uint32_t width = bw * 64, height = w.pages / bw * 32;
+    if (told++ == 0) std::fprintf(stderr, "[gs] the game's colour filter: one pass over %ux%u (frame %X, depth %X)\n", width, height, w.first_page, w.zbp);
+    if (cpu_raster()) {
+        std::uint32_t luma[256], dset[256], dadd[256], f[4][256];
+        for (std::uint32_t i = 0; i < 256; ++i) {
+            luma[i] = entry(w.luma, i), dset[i] = entry(w.dset, i), dadd[i] = entry(w.dadd, i);
+            for (int k = 0; k < 4; ++k) f[k][i] = entry(w.fin[k], i);
+        }
+        const std::uint32_t *fin[4] = {f[0], f[1], f[2], f[3]};
+        for (std::uint32_t y = 0; y < height; ++y)
+            for (std::uint32_t x = 0; x < width; ++x)
+                write_pixel(0x00, w.first_page, bw, x, y, apply(w, read_pixel(0x00, w.first_page, bw, x, y), read_pixel(w.zpsm, w.zbp, bw, x, y), luma, dset, dadd, fin));
+    }
+#ifdef PS2_GPU
+    if (gpu_on()) {
+        const std::uint32_t p[16] = {w.first_page, bw, width, height, w.zbp, w.zpsm, w.luma, w.weights[0], w.weights[1], w.weights[2], w.dset, w.dadd,
+                                     w.fin[0], w.fin[1], w.fin[2], w.fin[3]};
+        gpu::game_filter(p);
+    }
+#endif
+}
+
+// false: a draw of the walk, left out
+bool step(const State &s, std::uint64_t attr) {
+    const Context &c = s.ctx[(attr >> 9) & 1u];
+    const std::uint32_t fbp = static_cast<std::uint32_t>(c.frame & 0x1FFu) * 32u, fbw = static_cast<std::uint32_t>(c.frame >> 16) & 0x3Fu;
+    const std::uint32_t fpsm = static_cast<std::uint32_t>(c.frame >> 24) & 0x3Fu, fbmsk = static_cast<std::uint32_t>(c.frame >> 32);
+    const std::uint32_t tbp = static_cast<std::uint32_t>(c.tex0) & 0x3FFFu, tbw = static_cast<std::uint32_t>(c.tex0 >> 14) & 0x3Fu;
+    const std::uint32_t tpsm = static_cast<std::uint32_t>(c.tex0 >> 20) & 0x3Fu, cbp = static_cast<std::uint32_t>(c.tex0 >> 37) & 0x3FFFu;
+    const std::uint32_t fix = static_cast<std::uint32_t>(c.alpha >> 32) & 0xFFu, dmode = static_cast<std::uint32_t>(c.alpha >> 6) & 3u;
+    const bool textured = (attr & 0x10u) != 0, sprite = (attr & 7u) == 6;
+    Walk &w = g_walk;
+    if (!w.active) {
+        if (fbw > 1) {   // remember the width of each buffer drawn into
+            int i = 0;
+            while (i < std::min(g_last_n, 8) && g_last_bp[i] != fbp) ++i;
+            if (i == std::min(g_last_n, 8)) i = g_last_n++ % 8;
+            g_last_bp[i] = fbp, g_last_bw[i] = fbw;
+            return true;
+        }
+        const std::uint32_t zbp = static_cast<std::uint32_t>(c.zbuf & 0x1FFu) * 32u;
+        if (!(sprite && textured && fbw == 1 && fpsm == 0x0A && tpsm == 0x0A && tbw == 1 && tbp == zbp)) return true;
+        w = Walk{};   // the walk starts: the first page of the depth copied as 16-bit into a 64-wide buffer
+        w.active = true, w.zbp = zbp, w.zpsm = 0x30u | ((static_cast<std::uint32_t>(c.zbuf >> 24)) & 0xFu);
+    }
+    if (fbw != 1) {   // the walk is over
+        finish();
+        return step(s, attr);
+    }
+    if (textured && tpsm == 0x13) {   // a byte read through a palette
+        if (fix == 0x80) (dmode == 2 ? w.dset : w.dadd) = cbp;
+        else {
+            w.luma = cbp;
+            if ((w.nweights == 0 || w.weights[w.nweights - 1] != fix) && w.nweights < 3) w.weights[w.nweights++] = fix;
+        }
+    } else if (textured && tpsm == 0x1B && (fbmsk == 0x00FFFFFFu || fbmsk == 0xFF000000u)) {   // the four writes back into the frame's page
+        if (w.nfin == 0) w.first_page = fbp;
+        if (w.nfin < 4) w.fin[w.nfin++] = cbp;
+        if (fbmsk == 0x00FFFFFFu) ++w.alpha_writes, w.pages = w.alpha_writes / 2;   // two alpha writes a page
+    }
+    return false;
+}
+}  // namespace rdfilter
