+// rawdanger-recomp: Raw Danger's colour filter as one pass over the frame (gs.cpp rdfilter: p = frame bp, bw, width, height, depth
+// bp, depth psm, brightness palette, three weights, the two depth palettes, the four palettes of the writes)
+void game_filter(const std::uint32_t *p) {
+    g_why = kWhyCopy;
+    flush_all();
+    g_why = kWhyFlush;
+    const int w = static_cast<int>(p[2]), h = static_cast<int>(p[3]);
+    const Range frame = pages(p[0], p[1], 0x00, 0, 0, w - 1, h - 1);
+    if (g_live) {
+        const Range depth = pages(p[4], p[1], p[5], 0, 0, w - 1, h - 1);
+        hw::live_position(static_cast<std::uint32_t>(g_commands.size()));
+        hw::live_reader(depth.lo, depth.hi);
+        hw::live_reader(frame.lo, frame.hi);
+        for (int k = 6; k < 16; ++k)
+            if (k < 7 || k > 9) hw::live_reader(p[k] * 256u, p[k] * 256u + 1024u);
+        hw::live_writer(frame.lo, frame.hi);
+        hw::pal_write(p[0], p[1], 0x00, 0, 0, w - 1, h - 1);
+    }
+    if (hwcache::g_on) hwcache::write_region(p[0], p[1], 0x00, 0, 0, w - 1, h - 1, hwcache::kCopy);
+    mark_rendered(frame);
+    if (g_dec_on) stamp_pages(frame, true);
+    dispatch_linear(kGameFilter, static_cast<std::uint32_t>(w * h) * g_scale * g_scale,
+                    push_params({p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]}));
+}
