diff --git a/runtime/include/ps2/generated.hpp b/runtime/include/ps2/generated.hpp
index ff0489b..1f33b6f 100644
--- a/runtime/include/ps2/generated.hpp
+++ b/runtime/include/ps2/generated.hpp
@@ -44,6 +44,14 @@ bool window_module_in_place(std::uint32_t pc);
 
 void dispatch(Cpu &c, std::uint32_t entry, std::uint32_t depth);
 void call(Cpu &c, std::uint32_t target, std::uint32_t depth);
+// rawdanger-recomp: host functions the game can call. A guest address in [kHostCallBase, kHostCallBase + 4 * kHostCalls) runs
+// the host function registered for it (with the game's registers: arguments in a0-a3, the result goes in v0), then returns
+// to the caller as a guest function would. The range lies outside the console's memory, so no game code is ever there; data
+// the game reads (a menu's row records, a function pointer in a table) can point to it.
+constexpr std::uint32_t kHostCallBase = 0x0FF00000u;
+constexpr std::uint32_t kHostCalls = 256;
+using HostCall = void (*)(Cpu &c);
+void register_host_call(std::uint32_t index, HostCall fn);
 void bad_entry(Cpu &c, std::uint32_t unit_base);
 bool preempt(Cpu &c);
 
diff --git a/runtime/src/dispatch.cpp b/runtime/src/dispatch.cpp
index 14f495f..0c842e8 100644
--- a/runtime/src/dispatch.cpp
+++ b/runtime/src/dispatch.cpp
@@ -251,10 +251,23 @@ bool has_code(std::uint32_t pc) {
     return instance_for(pc, true) != nullptr;
 }
 
+HostCall g_host_calls[kHostCalls] = {};
+
+void register_host_call(std::uint32_t index, HostCall fn) {
+    if (index < kHostCalls) g_host_calls[index] = fn;
+}
+
 void dispatch(Cpu &c, std::uint32_t, std::uint32_t depth) {
     const std::uint32_t pc = c.pc;
     if (pc & kUnwind) return;
     if (pc == kHandlerReturn || pc == kIdle) return;
+    if (pc - kHostCallBase < kHostCalls * 4u) [[unlikely]] {
+        if (const HostCall fn = g_host_calls[(pc - kHostCallBase) >> 2]) {
+            fn(c);
+            c.pc = c.r[31].w[0];   // back to the caller, as a guest function's jr ra
+            return;
+        }
+    }
     const UnitInfo *u = unit_for(pc);
     const std::uint16_t id = u ? u->entries[(pc - u->base) >> 2] : 0;
     if (!id) {
