+// rawdanger-recomp (docs/NATIVE_RENDERER.md, phase 1): PS2_VU1_STATS=1 counts the VU1 programs by the code they run (a hash of the
+// microcode memory when it changed, and the start address) and prints them every 20,000 starts
+namespace vu1stats {
+std::uint64_t g_code_hash = 0;
+bool g_code_dirty = true;
+std::map<std::pair<std::uint64_t, std::uint32_t>, std::uint64_t> g_counts;
+std::uint64_t g_total = 0;
+const bool g_on = [] { const char *v = std::getenv("PS2_VU1_STATS"); return v && *v == '1'; }();
+void count(std::uint32_t address) {
+    if (g_code_dirty) {
+        std::uint64_t h = 1469598103934665603ull;
+        for (std::uint32_t i = 0; i < 16384u; ++i) h = (h ^ g_vu1_code[i]) * 1099511628211ull;
+        g_code_hash = h, g_code_dirty = false;
+    }
+    ++g_counts[{g_code_hash, address}];
+    if (++g_total % 20000u == 0) {
+        std::fprintf(stderr, "[vu1] %llu programs started; by code and address:\n", static_cast<unsigned long long>(g_total));
+        for (const auto &[k, n] : g_counts) std::fprintf(stderr, "[vu1]   code %016llX at %04X: %llu\n", static_cast<unsigned long long>(k.first), k.second, static_cast<unsigned long long>(n));
+    }
+}
+}  // namespace vu1stats
+
 void run_vu(int unit, std::uint32_t address, const Ctx &c) {
     Unit &u = c.u;
+    if (unit == 1 && vu1stats::g_on && !c.dry) vu1stats::count(address);
     if (unit == 1) {
         flush_vu(1);
         u.top = u.tops;
@@ -520,6 +545,7 @@ void execute(int unit, std::uint32_t cmd, const std::uint32_t *data, const Ctx &
             changed = true;
         }
         if (changed) vu::code_changed(unit);
+        if (changed && unit) vu1stats::g_code_dirty = true;
         break;
     }
     case 0x50: case 0x51:
