+    let w = params.size.x;
+    let h = params.size.y;
+    let s = f32(params.size.z);
+    let gx = (f32(x) + 0.5) / s;
+    let gy = (f32(y) + 0.5) / s;
+    if (in_hud(gx, gy)) {
