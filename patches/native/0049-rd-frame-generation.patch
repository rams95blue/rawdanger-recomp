+fn splat(@builtin(global_invocation_id) gid: vec3<u32>) {
+    if (gid.x >= params.size.x || gid.y >= params.size.y) {
+        return;
+    }
+    let l = land(gid.x, gid.y);
+    if (!l.ok) {
