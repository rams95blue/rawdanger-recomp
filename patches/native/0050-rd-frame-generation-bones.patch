+                    moved = true;
+                }
+            }
+            float a16[16];
+            for (int i = 0; i < 16; ++i) a16[i] = static_cast<float>(fc[i]);
+            double inv[16];
+            double A[16];
+            if (moved && invert4(a16, inv)) {
+                double ff[16];
+                for (int i = 0; i < 16; ++i) ff[i] = fp[i] + (fc[i] - fp[i]) * f;
+                for (int i = 0; i < 4; ++i)
+                    for (int k = 0; k < 4; ++k) {
+                        double v = 0;
+                        for (int q2 = 0; q2 < 4; ++q2) v += inv[i * 4 + q2] * ff[q2 * 4 + k];
+                        A[i * 4 + k] = v;
+                    }
+            } else {
+                for (int i = 0; i < 16; ++i) A[i] = (i % 5 == 0) ? 1.0 : 0.0;
+            }
