diff --git a/host/recomp_options.cpp b/host/recomp_options.cpp
new file mode 100644
index 0000000..24b83d4
--- /dev/null
+++ b/host/recomp_options.cpp
@@ -0,0 +1,131 @@
+#include "recomp_options.hpp"
+
+#include "ps2/memory.hpp"
+#include "ps2/system.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+
+namespace recomp {
+namespace {
+
+std::vector<Section> g_sections;
+std::string g_path;
+bool g_loaded = false;
+
+std::string trim(const std::string &s) {
+    const auto a = s.find_first_not_of(" \t\r\n"), b = s.find_last_not_of(" \t\r\n");
+    return a == std::string::npos ? std::string() : s.substr(a, b - a + 1);
+}
+
+// Puts the section's words in (or back to the original values) in memory now, and in the patch list the game thread
+// writes every frame (patch=1 lines are written again at each frame, so the list has to say the same thing).
+void set_words(const Section &s, bool on) {
+    for (const Word &w : s.words) {
+        const std::uint32_t value = on ? w.patched : w.original;
+        for (ps2::Patch &p : ps2::g_options.patches)
+            if (p.address == w.address && p.bytes == 4) p.value = value;
+        ps2::st32(w.address, value);
+    }
+}
+
+void save() {
+    if (g_path.empty()) return;
+    // only the on= lines change: the rest of the file is the launcher's, so it is copied as it is
+    std::ifstream in(g_path);
+    if (!in) return;
+    std::stringstream out;
+    std::string line, section;
+    while (std::getline(in, line)) {
+        const std::string t = trim(line);
+        if (t.size() > 2 && t.front() == '[' && t.back() == ']') section = t.substr(1, t.size() - 2);
+        else if (t.rfind("on", 0) == 0 && t.find('=') != std::string::npos && trim(t.substr(0, t.find('='))) == "on") {
+            for (const Section &s : g_sections)
+                if (s.name == section) { line = std::string("on = ") + (s.on ? "1" : "0"); break; }
+        }
+        out << line << "\n";
+    }
+    in.close();
+    std::ofstream w(g_path, std::ios::trunc);
+    w << out.str();
+}
+
+}  // namespace
+
+bool loaded() { return g_loaded; }
+std::vector<Section> &sections() { return g_sections; }
+
+bool load(const char *path) {
+    g_sections.clear();
+    g_loaded = false;
+    if (!path || !*path) return false;
+    std::ifstream in(path);
+    if (!in) {
+        std::fprintf(stderr, "[recomp] no options file %s\n", path);
+        return false;
+    }
+    g_path = path;
+    std::string line;
+    Section *cur = nullptr;
+    while (std::getline(in, line)) {
+        const std::string t = trim(line);
+        if (t.empty() || t[0] == '#' || t[0] == ';') continue;
+        if (t.front() == '[' && t.back() == ']') {
+            g_sections.push_back(Section());
+            cur = &g_sections.back();
+            cur->name = cur->label = t.substr(1, t.size() - 2);
+            continue;
+        }
+        const auto eq = t.find('=');
+        if (!cur || eq == std::string::npos) continue;
+        const std::string k = trim(t.substr(0, eq)), v = trim(t.substr(eq + 1));
+        if (k == "label") cur->label = v;
+        else if (k == "live") cur->live = v == "1";
+        else if (k == "on") cur->on = v != "0";
+        else if (k == "aspect") cur->aspect169 = v == "16:9";
+        else if (k == "word") {
+            Word w;
+            unsigned a = 0, p = 0, o = 0;
+            if (std::sscanf(v.c_str(), "%x %x %x", &a, &p, &o) == 3) {
+                w.address = a; w.patched = p; w.original = o;
+                cur->words.push_back(w);
+            }
+        }
+    }
+    g_loaded = true;
+    std::fprintf(stderr, "[recomp] %zu options from %s\n", g_sections.size(), path);
+    return true;
+}
+
+void apply_startup() {
+    for (Section &s : g_sections) {
+        if (!s.live) continue;
+        // the patch list was read from patches.txt (everything the build turned on); a live section switched off keeps its
+        // original values instead, from the first frame on
+        for (const Word &w : s.words)
+            for (ps2::Patch &p : ps2::g_options.patches)
+                if (p.address == w.address && p.bytes == 4) p.value = s.on ? w.patched : w.original;
+        if (s.aspect169) ps2::g_options.widescreen = s.on;
+        std::fprintf(stderr, "[recomp] %s: %s\n", s.label.c_str(), s.on ? "on" : "off");
+    }
+}
+
+bool toggle(std::size_t index, std::string &note) {
+    if (index >= g_sections.size()) return false;
+    Section &s = g_sections[index];
+    if (!s.live) {
+        note = s.label + " is built into the game: change it in RawDangerPC.exe and build again";
+        return false;
+    }
+    s.on = !s.on;
+    set_words(s, s.on);
+    if (s.aspect169) ps2::g_options.widescreen = s.on;
+    save();
+    note = s.label + (s.on ? ": on" : ": off");
+    std::fprintf(stderr, "[recomp] %s switched %s in the game\n", s.label.c_str(), s.on ? "on" : "off");
+    return true;
+}
+
+}  // namespace recomp
diff --git a/host/recomp_options.hpp b/host/recomp_options.hpp
new file mode 100644
index 0000000..0966444
--- /dev/null
+++ b/host/recomp_options.hpp
@@ -0,0 +1,38 @@
+#pragma once
+
+// rawdanger-recomp: the game's patches as options (the "Recomp options" page of the F1 menu). RawDangerPC.exe writes
+// games\<name>\recomp.ini when it builds a game and passes its path in PS2_RECOMP_OPTIONS; this side reads it, applies the
+// choices at the start, lets the player switch the live ones in the game, and writes the choices back, so the launcher
+// and the menu always show the same thing.
+//
+// recomp.ini, one [section] per patch section of the game's .pnach:
+//   label = Widescreen 16:9        what the menu shows
+//   live  = 1                      the patch only writes data: it can be switched while the game runs
+//   on    = 1                      the player's choice (live sections); built-in ones are always as built
+//   aspect = 16:9                  the section also sets the picture's shape
+//   word  = 003A83E0 43E00000 43A00000    address, patched value, original value (live sections)
+// Code patches (live = 0) are compiled into the game: the menu lists them as built in.
+
+#include <string>
+#include <vector>
+#include <cstdint>
+
+namespace recomp {
+
+struct Word {
+    std::uint32_t address = 0, patched = 0, original = 0;
+};
+
+struct Section {
+    std::string name, label;
+    bool live = false, on = true, aspect169 = false;
+    std::vector<Word> words;
+};
+
+bool load(const char *path);                // false when there is no file (then the menu page says so)
+void apply_startup();                       // the choices of the file, before the game starts
+std::vector<Section> &sections();
+bool toggle(std::size_t index, std::string &note);  // live sections: on <-> off now, written back to the file
+bool loaded();
+
+}  // namespace recomp
