diff --git a/host/keymap.cpp b/host/keymap.cpp
index 96f8798..639eb82 100644
--- a/host/keymap.cpp
+++ b/host/keymap.cpp
@@ -160,6 +160,7 @@ std::string with_line(const std::string &file_text, const std::string &name, con
 std::string with_look(const std::string &file_text, int look) { return with_line(file_text, "look", std::string("look = ") + look_word(look)); }
 
 std::string with_scale(const std::string &file_text, int scale) { return with_line(file_text, "scale", "scale = " + (scale == kScaleAuto ? std::string("auto") : std::to_string(scale))); }
+std::string with_menu_skin(const std::string &file_text, int skin) { return with_line(file_text, "menuskin", std::string("menu_skin = ") + (skin == 1 ? "japanese" : "hazard")); }
 std::string with_integer_scale(const std::string &file_text, int on) { return with_line(file_text, "integerscale", "integer_scale = " + std::to_string(on ? 1 : 0)); }
 std::string with_lens_rain(const std::string &file_text, int level) { return with_line(file_text, "lensrain", "lens_rain = " + std::to_string(level)); }
 std::string with_smaa(const std::string &file_text, int on) { return with_line(file_text, "smaa", "smaa = " + std::to_string(on ? 1 : 0)); }
@@ -310,6 +311,13 @@ void parse(const std::string &text, Config &config, std::vector<std::string> &pr
             else bad("smaa is on or off, ignored");
             continue;
         }
+        if (name == "menuskin") {
+            const std::string v = squash(value);
+            if (v == "hazard" || v == "0") config.menu_skin = 0;
+            else if (v == "japanese" || v == "jp" || v == "1") config.menu_skin = 1;
+            else bad("menu_skin is hazard or japanese, ignored");
+            continue;
+        }
         if (name == "integerscale" || name == "lensrain") {
             char *tail = nullptr;
             const long v = std::strtol(value.c_str(), &tail, 10);
diff --git a/host/keymap.hpp b/host/keymap.hpp
index a2ea7f0..43e0df5 100644
--- a/host/keymap.hpp
+++ b/host/keymap.hpp
@@ -40,6 +40,8 @@ struct Config {
 
     int pause_unfocused = 1;   // rawdanger-recomp: the quick menu opens (the game waits) when the window goes to the background
     int master_volume = 100;
+    int menu_skin = -1;        // rawdanger-recomp: the F1 menu's look: 0 hazard (yellow on black), 1 Japanese (blue on white, the
+                               // launcher's Japanese skin); -1 = from the game's language (PS2_LANGUAGE / PS2_MENU_SKIN)
     int integer_scale = 0;     // rawdanger-recomp: the picture is enlarged by whole numbers only (every console pixel row the same height)
     int lens_rain = 0;         // rawdanger-recomp: rain drops on the lens while playing: 0 off, 1 light, 2 heavy
     int smaa = 0;              // rawdanger-recomp: SMAA 1x on the console picture (anti-aliasing), 0 off, 1 on   // rawdanger-recomp: the volume of everything the game plays, 0 to 100 (%)
@@ -61,6 +63,7 @@ const char *sharp_2d_word(int sharp);  // "soft", "sharp", "sharpest"
 std::string with_pause_unfocused(const std::string &file_text, int on);  // the 'pause_unfocused' line
 std::string with_master_volume(const std::string &file_text, int percent);
 std::string with_integer_scale(const std::string &file_text, int on);
+std::string with_menu_skin(const std::string &file_text, int skin);   // the 'menu_skin' line: hazard / japanese
 std::string with_lens_rain(const std::string &file_text, int level);
 std::string with_smaa(const std::string &file_text, int on);  // the 'master_volume' line
 
