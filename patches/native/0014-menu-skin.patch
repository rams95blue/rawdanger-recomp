-constexpr int kGraphicsEntries = 11;
+constexpr int kGraphicsEntries = 12;
 constexpr Command kGraphics[kGraphicsEntries] = {Command::scale,      Command::look,      Command::antialias,     Command::integer_scale,   Command::sharp_2d, Command::fullscreen,
