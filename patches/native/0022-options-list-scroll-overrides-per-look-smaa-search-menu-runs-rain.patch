-        const float rate = (g_level == 1 ? 2.5f : 8.0f) * strength;
-        const std::size_t most = g_level == 1 ? 24 : kMost;
+        const float rate = 9.0f * strength * g_gust;
+        const std::size_t most = std::min<std::size_t>(kMost, static_cast<std::size_t>(16.0f + 48.0f * strength * std::min(g_gust, 1.0f)));
         float expect = rate * seconds;
         while (expect > 0.0f && g_drops.size() < most) {
-            if (uniform(0.0f, 1.0f) < expect) spawn(strength);
+            if (uniform(0.0f, 1.0f) < expect) spawn(std::min(1.0f, strength * g_gust));
             expect -= 1.0f;
         }
     }
     // the mist follows the rain: up in a few seconds of heavy rain, gone within a few seconds out of it
-    const float mist_goal = on ? strength * (g_level == 1 ? 0.35f : 0.7f) : 0.0f;
+    const float mist_goal = on ? std::min(0.85f, strength * 0.6f * (0.6f + 0.4f * g_gust)) : 0.0f;
     g_mist += (mist_goal - g_mist) * std::min(1.0f, seconds * (mist_goal > g_mist ? 0.25f : 0.6f));
     for (Drop &d : g_drops) {
         d.age += seconds;
