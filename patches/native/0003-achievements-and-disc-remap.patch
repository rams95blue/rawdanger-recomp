diff --git a/host/achievements.cpp b/host/achievements.cpp
new file mode 100644
index 0000000..655c636
--- /dev/null
+++ b/host/achievements.cpp
@@ -0,0 +1,441 @@
+#include "achievements.hpp"
+
+#include "ps2/memory.hpp"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <fstream>
+#include <mutex>
+#include <set>
+#include <sstream>
+
+namespace achievements {
+namespace {
+
+enum class Size { b8, b16, b32, bit0, bit1, bit2, bit3, bit4, bit5, bit6, bit7, low4, high4 };
+enum class Kind { value, mem, delta, prior };
+
+struct Operand {
+    Kind kind = Kind::value;
+    Size size = Size::b8;
+    std::uint32_t address = 0, value = 0;
+    // per-frame memory of a memory operand (delta / prior)
+    std::uint32_t last = 0, prior = 0;
+    bool seen = false;
+};
+
+enum class Flag { none, reset, pause, add_source, sub_source, and_next, or_next, add_hits, add_address };
+enum class Cmp { eq, ne, lt, le, gt, ge, none };
+
+struct Cond {
+    Flag flag = Flag::none;
+    Operand left, right;
+    Cmp cmp = Cmp::none;
+    std::uint32_t target = 0, hits = 0;  // .N. (0: no hit count)
+};
+
+struct Group {
+    std::vector<Cond> conds;
+};
+
+struct Achievement {
+    std::string id, title, description;
+    int points = 0;
+    std::vector<Group> groups;  // [0] core, then alternatives
+    bool unlocked = false, primed = false;  // primed: seen false once since loading
+};
+
+std::vector<Achievement> g_list;
+std::string g_unlocks_path, g_note;
+std::mutex g_lock;
+bool g_loaded = false;
+
+std::string trim(const std::string &s) {
+    const auto a = s.find_first_not_of(" \t\r\n"), b = s.find_last_not_of(" \t\r\n");
+    return a == std::string::npos ? std::string() : s.substr(a, b - a + 1);
+}
+
+// ---- reading the conditions ------------------------------------------------------------------------------------------
+
+bool parse_operand(const std::string &t, std::size_t &i, Operand &o) {
+    auto hex = [&](std::uint32_t &v) {
+        std::size_t start = i;
+        v = 0;
+        while (i < t.size() && std::isxdigit(static_cast<unsigned char>(t[i]))) v = v * 16 + static_cast<std::uint32_t>(std::stoi(std::string(1, t[i++]), nullptr, 16));
+        return i > start;
+    };
+    o = Operand();
+    Kind k = Kind::mem;
+    if (i < t.size() && (t[i] == 'd' || t[i] == 'p' || t[i] == 'b')) {
+        k = t[i] == 'd' ? Kind::delta : t[i] == 'p' ? Kind::prior : Kind::mem;  // b (BCD) read as plain
+        ++i;
+    }
+    if (t.compare(i, 2, "0x") == 0) {
+        i += 2;
+        o.kind = k;
+        o.size = Size::b16;
+        if (i < t.size()) {
+            const char c = t[i];
+            switch (c) {
+            case 'H': case 'h': o.size = Size::b8; ++i; break;
+            case 'X': case 'x': o.size = Size::b32; ++i; break;
+            case ' ': o.size = Size::b16; ++i; break;
+            case 'M': o.size = Size::bit0; ++i; break;
+            case 'N': o.size = Size::bit1; ++i; break;
+            case 'O': o.size = Size::bit2; ++i; break;
+            case 'P': o.size = Size::bit3; ++i; break;
+            case 'Q': o.size = Size::bit4; ++i; break;
+            case 'R': o.size = Size::bit5; ++i; break;
+            case 'S': o.size = Size::bit6; ++i; break;
+            case 'T': o.size = Size::bit7; ++i; break;
+            case 'L': o.size = Size::low4; ++i; break;
+            case 'U': o.size = Size::high4; ++i; break;
+            default: break;  // 0x1234: 16 bit
+            }
+        }
+        return hex(o.address);
+    }
+    o.kind = Kind::value;
+    if (i < t.size() && (t[i] == 'h' || t[i] == 'H')) {
+        ++i;
+        return hex(o.value);
+    }
+    if (i < t.size() && (t[i] == 'v' || t[i] == 'V')) ++i;  // v123
+    std::size_t start = i;
+    std::uint64_t v = 0;
+    while (i < t.size() && std::isdigit(static_cast<unsigned char>(t[i]))) v = v * 10 + static_cast<unsigned>(t[i++] - '0');
+    o.value = static_cast<std::uint32_t>(v);
+    return i > start;
+}
+
+bool parse_cond(const std::string &t, Cond &c) {
+    std::size_t i = 0;
+    c = Cond();
+    if (t.size() > 2 && t[1] == ':') {
+        switch (t[0]) {
+        case 'R': c.flag = Flag::reset; break;
+        case 'P': c.flag = Flag::pause; break;
+        case 'A': c.flag = Flag::add_source; break;
+        case 'B': c.flag = Flag::sub_source; break;
+        case 'N': c.flag = Flag::and_next; break;
+        case 'O': c.flag = Flag::or_next; break;
+        case 'C': c.flag = Flag::add_hits; break;
+        case 'I': c.flag = Flag::add_address; break;
+        default: break;  // M: Q: T: Z: K: ...: evaluated as plain conditions
+        }
+        i = 2;
+    }
+    if (!parse_operand(t, i, c.left)) return false;
+    if (i >= t.size()) return true;  // a lone operand (A:/B:/I: lines)
+    if (t.compare(i, 2, "!=") == 0) { c.cmp = Cmp::ne; i += 2; }
+    else if (t.compare(i, 2, "<=") == 0) { c.cmp = Cmp::le; i += 2; }
+    else if (t.compare(i, 2, ">=") == 0) { c.cmp = Cmp::ge; i += 2; }
+    else if (t[i] == '=') { c.cmp = Cmp::eq; ++i; }
+    else if (t[i] == '<') { c.cmp = Cmp::lt; ++i; }
+    else if (t[i] == '>') { c.cmp = Cmp::gt; ++i; }
+    else if (t[i] == '*' || t[i] == '/' || t[i] == '&' || t[i] == '^') return true;  // arithmetic modifiers: not supported, read as the left side
+    else return false;
+    if (!parse_operand(t, i, c.right)) return false;
+    if (i < t.size() && (t[i] == '.' || t[i] == '(')) {
+        ++i;
+        std::uint32_t h = 0;
+        while (i < t.size() && std::isdigit(static_cast<unsigned char>(t[i]))) h = h * 10 + static_cast<unsigned>(t[i++] - '0');
+        c.target = h;
+    }
+    return true;
+}
+
+bool parse_logic(const std::string &logic, std::vector<Group> &groups) {
+    groups.clear();
+    std::string group;
+    std::stringstream gs(logic);
+    bool first = true;
+    while (std::getline(gs, group, 'S')) {
+        if (!first && group.empty()) continue;
+        first = false;
+        Group g;
+        std::stringstream cs(group);
+        std::string cond;
+        while (std::getline(cs, cond, '_')) {
+            if (cond.empty()) continue;
+            Cond c;
+            if (!parse_cond(cond, c)) return false;
+            g.conds.push_back(c);
+        }
+        groups.push_back(g);
+    }
+    return !groups.empty();
+}
+
+// ---- checking them ---------------------------------------------------------------------------------------------------
+
+std::uint32_t read_mem(Size s, std::uint32_t a) {
+    a &= 0x01FFFFFFu;  // EE main memory
+    switch (s) {
+    case Size::b8: return ps2::ld8(a);
+    case Size::b16: return ps2::ld16(a & ~1u);
+    case Size::b32: return ps2::ld32(a & ~3u);
+    case Size::low4: return ps2::ld8(a) & 0xF;
+    case Size::high4: return ps2::ld8(a) >> 4;
+    default: return (ps2::ld8(a) >> (static_cast<int>(s) - static_cast<int>(Size::bit0))) & 1;
+    }
+}
+
+// The operand's value this frame; memory operands also move their delta / prior history (once per frame: `step`).
+std::uint32_t value_of(Operand &o, std::uint32_t offset, bool step) {
+    if (o.kind == Kind::value) return o.value;
+    const std::uint32_t now = read_mem(o.size, o.address + offset);
+    std::uint32_t result = now;
+    if (o.kind == Kind::delta) result = o.seen ? o.last : now;
+    else if (o.kind == Kind::prior) result = o.seen ? o.prior : now;
+    if (step) {
+        if (o.seen && now != o.last) o.prior = o.last;
+        o.last = now;
+        o.seen = true;
+    }
+    return result;
+}
+
+bool compare(Cmp c, std::uint32_t a, std::uint32_t b) {
+    switch (c) {
+    case Cmp::eq: return a == b;
+    case Cmp::ne: return a != b;
+    case Cmp::lt: return a < b;
+    case Cmp::le: return a <= b;
+    case Cmp::gt: return a > b;
+    case Cmp::ge: return a >= b;
+    default: return a != 0;
+    }
+}
+
+// One group: true when every plain condition holds (hit counts reached); reset / pause seen separately.
+bool check_group(Group &g, bool &reset, bool &paused) {
+    bool all = true;
+    std::int64_t add = 0;
+    std::uint32_t address_offset = 0;
+    int chain = -1;  // -1 none, 0 false, 1 true: AndNext / OrNext carried into the next condition
+    std::uint32_t extra_hits = 0;
+    // pause conditions first, as RetroAchievements does: a paused group keeps its hit counts and is not true
+    for (Cond &c : g.conds)
+        if (c.flag == Flag::pause) {
+            const std::uint32_t l = value_of(c.left, 0, false), r = value_of(c.right, 0, false);
+            if (compare(c.cmp, l, r)) paused = true;
+        }
+    if (paused) {
+        for (Cond &c : g.conds) { value_of(c.left, 0, true); value_of(c.right, 0, true); }
+        return false;
+    }
+    for (Cond &c : g.conds) {
+        const std::uint32_t l = value_of(c.left, address_offset, true);
+        if (c.flag == Flag::add_address) { address_offset = l; continue; }
+        const std::uint32_t r = value_of(c.right, address_offset, true);
+        address_offset = 0;
+        if (c.flag == Flag::add_source) { add += l; continue; }
+        if (c.flag == Flag::sub_source) { add -= l; continue; }
+        const std::uint32_t left = static_cast<std::uint32_t>(static_cast<std::int64_t>(l) + add);
+        add = 0;
+        bool truth = compare(c.cmp, left, r);
+        if (chain == 0 && c.flag != Flag::or_next) truth = false;
+        if (c.flag == Flag::and_next) { chain = truth && chain != 0 ? 1 : 0; continue; }
+        if (c.flag == Flag::or_next) { chain = truth || chain == 1 ? 1 : 0; continue; }
+        if (chain == 1) truth = truth || false;
+        chain = -1;
+        if (c.flag == Flag::add_hits) { if (truth) ++extra_hits; continue; }
+        if (c.flag == Flag::pause) continue;
+        if (c.flag == Flag::reset) { if (truth) reset = true; continue; }
+        if (c.target) {
+            if (truth && c.hits < c.target) ++c.hits;
+            if (c.hits + extra_hits < c.target) all = false;
+            extra_hits = 0;
+        } else if (!truth) {
+            all = false;
+        }
+    }
+    return all;
+}
+
+void clear_hits(Achievement &a) {
+    for (Group &g : a.groups)
+        for (Cond &c : g.conds) c.hits = 0;
+}
+
+bool check(Achievement &a) {
+    bool reset = false, paused = false;
+    bool core = check_group(a.groups[0], reset, paused);
+    bool any_alt = a.groups.size() == 1;
+    for (std::size_t i = 1; i < a.groups.size(); ++i) {
+        bool p = false;
+        if (check_group(a.groups[i], reset, p)) any_alt = true;
+    }
+    if (reset) { clear_hits(a); return false; }
+    return core && any_alt && !paused;
+}
+
+void save_unlock(const Achievement &a) {
+    if (g_unlocks_path.empty()) return;
+    std::ofstream f(g_unlocks_path, std::ios::app);
+    const std::time_t now = std::time(nullptr);
+    char when[32];
+    std::strftime(when, sizeof when, "%Y-%m-%d %H:%M", std::localtime(&now));
+    f << a.id << "\t" << when << "\t" << a.title << "\n";
+}
+
+// ---- the two file forms ----------------------------------------------------------------------------------------------
+
+// RACache\Data\<id>.json: only the fields used here, read without a JSON library (strings with \" and \\ escapes)
+std::string json_field(const std::string &obj, const std::string &key) {
+    const std::string k = "\"" + key + "\"";
+    std::size_t at = obj.find(k);
+    if (at == std::string::npos) return "";
+    at = obj.find(':', at + k.size());
+    if (at == std::string::npos) return "";
+    ++at;
+    while (at < obj.size() && (obj[at] == ' ' || obj[at] == '\t' || obj[at] == '\n' || obj[at] == '\r')) ++at;
+    if (at < obj.size() && obj[at] == '"') {
+        std::string out;
+        for (++at; at < obj.size() && obj[at] != '"'; ++at) {
+            if (obj[at] == '\\' && at + 1 < obj.size()) { ++at; out += obj[at] == 'n' ? '\n' : obj[at]; }
+            else out += obj[at];
+        }
+        return out;
+    }
+    std::size_t end = at;
+    while (end < obj.size() && obj[end] != ',' && obj[end] != '}') ++end;
+    return trim(obj.substr(at, end - at));
+}
+
+void load_json(const std::string &text) {
+    std::size_t at = text.find("\"Achievements\"");
+    if (at == std::string::npos) return;
+    at = text.find('[', at);
+    int depth = 0;
+    std::size_t start = 0;
+    for (std::size_t i = at; i < text.size(); ++i) {
+        if (text[i] == '"') { for (++i; i < text.size() && text[i] != '"'; ++i) if (text[i] == '\\') ++i; continue; }
+        if (text[i] == '{') { if (depth++ == 0) start = i; }
+        else if (text[i] == '}') {
+            if (--depth == 0) {
+                const std::string obj = text.substr(start, i - start + 1);
+                Achievement a;
+                a.id = json_field(obj, "ID");
+                a.title = json_field(obj, "Title");
+                a.description = json_field(obj, "Description");
+                a.points = std::atoi(json_field(obj, "Points").c_str());
+                if (json_field(obj, "Flags") == "5") continue;  // unofficial ones
+                if (parse_logic(json_field(obj, "MemAddr"), a.groups)) g_list.push_back(a);
+                else std::fprintf(stderr, "[achievements] %s: condition not understood, skipped\n", a.title.c_str());
+            }
+        } else if (text[i] == ']' && depth == 0) break;
+    }
+}
+
+void load_text(const std::string &text) {
+    std::stringstream in(text);
+    std::string line, logic;
+    Achievement cur;
+    bool have = false;
+    auto flush = [&] {
+        if (have && parse_logic(logic, cur.groups)) g_list.push_back(cur);
+        else if (have) std::fprintf(stderr, "[achievements] %s: condition not understood, skipped\n", cur.title.c_str());
+        cur = Achievement();
+        logic.clear();
+        have = false;
+    };
+    while (std::getline(in, line)) {
+        const std::string t = trim(line);
+        if (t.empty() || t[0] == '#') continue;
+        if (t.front() == '[' && t.back() == ']') {
+            flush();
+            cur.id = t.substr(1, t.size() - 2);
+            have = true;
+            continue;
+        }
+        const auto eq = t.find('=');
+        if (eq == std::string::npos) continue;
+        const std::string k = trim(t.substr(0, eq)), v = trim(t.substr(eq + 1));
+        if (k == "title") cur.title = v;
+        else if (k == "description") cur.description = v;
+        else if (k == "points") cur.points = std::atoi(v.c_str());
+        else if (k == "logic") logic = v;
+    }
+    flush();
+}
+
+}  // namespace
+
+bool load(const char *set_path, const std::string &unlocks_path) {
+    std::lock_guard<std::mutex> hold(g_lock);
+    g_list.clear();
+    g_loaded = false;
+    if (!set_path || !*set_path) return false;
+    std::ifstream in(set_path, std::ios::binary);
+    if (!in) {
+        std::fprintf(stderr, "[achievements] no set file %s\n", set_path);
+        return false;
+    }
+    std::stringstream ss;
+    ss << in.rdbuf();
+    const std::string text = ss.str();
+    if (text.find("\"Achievements\"") != std::string::npos) load_json(text);
+    else load_text(text);
+    g_unlocks_path = unlocks_path;
+    std::set<std::string> done;
+    std::ifstream u(unlocks_path);
+    std::string line;
+    while (std::getline(u, line)) done.insert(line.substr(0, line.find('\t')));
+    for (Achievement &a : g_list) a.unlocked = done.count(a.id) != 0;
+    g_loaded = !g_list.empty();
+    std::fprintf(stderr, "[achievements] %zu achievements from %s, %zu already unlocked\n", g_list.size(), set_path, done.size());
+    return g_loaded;
+}
+
+void frame() {
+    if (!g_loaded) return;
+    std::lock_guard<std::mutex> hold(g_lock);
+    for (Achievement &a : g_list) {
+        if (a.unlocked) continue;
+        const bool now = check(a);
+        if (!now) { a.primed = true; continue; }
+        if (!a.primed) continue;  // true from the first frame on (a loaded save): wait for it to be false once
+        a.unlocked = true;
+        save_unlock(a);
+        g_note = "Achievement unlocked: " + a.title + (a.points ? " (" + std::to_string(a.points) + ")" : "");
+        std::fprintf(stderr, "[achievements] unlocked %s - %s\n", a.id.c_str(), a.title.c_str());
+    }
+}
+
+std::vector<Row> rows() {
+    std::lock_guard<std::mutex> hold(g_lock);
+    std::vector<Row> out;
+    for (const Achievement &a : g_list) out.push_back({a.title, a.description, a.points, a.unlocked});
+    return out;
+}
+
+std::string take_note() {
+    std::lock_guard<std::mutex> hold(g_lock);
+    std::string n;
+    n.swap(g_note);
+    return n;
+}
+
+bool loaded() { return g_loaded; }
+
+int unlocked_count() {
+    std::lock_guard<std::mutex> hold(g_lock);
+    int n = 0;
+    for (const Achievement &a : g_list) n += a.unlocked;
+    return n;
+}
+
+int total_points(bool unlocked_only) {
+    std::lock_guard<std::mutex> hold(g_lock);
+    int n = 0;
+    for (const Achievement &a : g_list)
+        if (!unlocked_only || a.unlocked) n += a.points;
+    return n;
+}
+
+}  // namespace achievements
diff --git a/host/achievements.hpp b/host/achievements.hpp
new file mode 100644
index 0000000..26d8ca6
--- /dev/null
+++ b/host/achievements.hpp
@@ -0,0 +1,43 @@
+#pragma once
+
+// rawdanger-recomp: offline achievements. The game's memory is checked once per frame against the conditions of an
+// achievement set; an achievement unlocks when its conditions become true (after having been false at least once, so a
+// loaded save does not unlock everything at once), a note shows it over the picture, and the unlocks are kept in a file
+// next to the saves. Nothing goes over the network.
+//
+// The set comes from PS2_ACHIEVEMENTS=<file>, in either form:
+//   - our own text form (RawDangerPC.exe ships one):
+//       [id]
+//       title = Into the water
+//       description = ...
+//       points = 5
+//       logic = 0xX48F488=21          (the condition, in RetroAchievements' memory syntax, below)
+//   - a RetroAchievements cache file of the player's own (RACache\Data\<game id>.json, written by a RetroAchievements
+//     emulator after logging in): its "Achievements" list with ID, Title, Description, Points and MemAddr is read as is.
+//
+// Supported condition syntax (RetroAchievements memory strings): sizes 0xH (8 bit), 0x / 0x  (16 bit), 0xX (32 bit),
+// 0xM..0xT (bit 0..7), 0xL / 0xU (low / high nibble); d (delta: last frame's value) and p (prior: the value before it
+// last changed) prefixes; values as decimal or hFF; = != < <= > >=; hit counts .N.; flags R: (reset) P: (pause)
+// A: (add source) B: (sub source) N: (and next) O: (or next) C: (add hits) I: (add address) M: Q: T: (as plain);
+// core group and alternatives separated by S. PS2 addresses are EE main memory (0 ... 0x1FFFFFF).
+
+#include <string>
+#include <vector>
+
+namespace achievements {
+
+struct Row {
+    std::string title, description;
+    int points = 0;
+    bool unlocked = false;
+};
+
+bool load(const char *set_path, const std::string &unlocks_path);  // false: no set
+void frame();                                                         // once per video frame: check, unlock
+std::vector<Row> rows();                                              // for the menu page
+std::string take_note();                                              // "Achievement unlocked: ..." once, then empty
+bool loaded();
+int unlocked_count();
+int total_points(bool unlocked_only);
