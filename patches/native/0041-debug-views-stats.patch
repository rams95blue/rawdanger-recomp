+            g_stats_rows.push_back({"Scene", std::to_string(ps2::ld32(d.scene)) + (cam >= 0x100000u && cam < 0x2000000u ? ", camera mode " + std::to_string(ps2::ld32(cam + d.mode)) : "")});
