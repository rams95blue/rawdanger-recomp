             break;
@@ -3459,6 +3482,23 @@ void show_speed() {
                   (cpu - cpu_start) / seconds * 100.0, (gpu - gpu_start) / (seconds * 10.0), resident_mb(), queued, stretched);
     g_speed_title = title;
     refresh_title();
+    if (g_stats_on) {
+        char a[64], b[64], c[64];
