+        be[1].binding = 1; be[1].buffer = g_smaa_work; be[1].size = WGPU_WHOLE_SIZE;
+        be[2].binding = 2; be[2].buffer = g_smaa_lut; be[2].size = WGPU_WHOLE_SIZE;
