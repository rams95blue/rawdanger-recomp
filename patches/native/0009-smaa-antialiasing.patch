+        if (g_smaa_group) wgpuBindGroupRelease(g_smaa_group);
+        g_smaa_words = n * 3;
+        g_smaa_work = make_buffer(g_smaa_words * 4, WGPUBufferUsage_Storage | WGPUBufferUsage_CopySrc);
