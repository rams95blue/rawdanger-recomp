diff --git a/host/lens_rain.cpp b/host/lens_rain.cpp
new file mode 100644
index 0000000..fbe58ef
--- /dev/null
+++ b/host/lens_rain.cpp
@@ -0,0 +1,119 @@
+// rawdanger-recomp: rain drops on the lens while playing (keys.ini lens_rain = 0 off, 1 light, 2 heavy; F1 -> Graphics and sound).
+// Drops land at random places, stay a moment, then run down and fade, like rain on a camera; they are drawn over the picture by
+// blit.wgsl (drops_over). Written for this project; the idea is the one of rain-drop mods for PC games, no code is taken from them.
+//
+// When: PS2_LENS_WHEN="ADDRESS=VALUE" (a 32-bit word of the game's memory, e.g. Raw Danger's scene 0x48F488=21 = playing; set by
+// RawDangerPC.exe) lets drops land only while the game says it is playing; without it they land all the time (menus included).
+// Off, or when the game stops playing (a menu, a film), the drops on the lens run off within a second.
+#include "lens_rain.hpp"
+
+#include "ps2/memory.hpp"
+#include "ps2/video.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace lens_rain {
+namespace {
+
+struct Drop {
+    float x, y, r;      // centre (0 ... 1 of the picture), radius (a share of its height)
+    float age, life;    // seconds
+    float hold;         // seconds it clings before it starts to run
+    float speed;        // picture heights per second once it runs
+    float alpha;
+};
+
+int g_level = 0;
+std::vector<Drop> g_drops;
+std::mt19937 g_random{20061108u};
+bool g_when_set = false;
+std::uint32_t g_when_address = 0, g_when_value = 0;
+bool g_parsed = false;
+
+void parse_when() {
+    g_parsed = true;
+    const char *w = std::getenv("PS2_LENS_WHEN");
+    if (!w || !*w) return;
+    const std::string s(w);
+    const std::size_t eq = s.find('=');
+    if (eq == std::string::npos) return;
+    g_when_address = static_cast<std::uint32_t>(std::strtoul(s.substr(0, eq).c_str(), nullptr, 0)) & 0x01FFFFFCu;
+    g_when_value = static_cast<std::uint32_t>(std::strtoul(s.substr(eq + 1).c_str(), nullptr, 0));
+    g_when_set = true;
+}
+
+bool playing() {
+    if (!g_parsed) parse_when();
+    if (!g_when_set) return true;
+    std::uint32_t v = 0;
+    for (int i = 0; i < 4; ++i) v |= static_cast<std::uint32_t>(ps2::ld8(g_when_address + static_cast<std::uint32_t>(i))) << (8 * i);
+    return v == g_when_value;
+}
+
+float uniform(float a, float b) { return std::uniform_real_distribution<float>(a, b)(g_random); }
+
+}  // namespace
+
+void set_level(int level) { g_level = std::clamp(level, 0, 2); }
+int level() { return g_level; }
+bool knows_when() {
+    if (!g_parsed) parse_when();
+    return g_when_set;
+}
+
+void frame(float seconds) {
+    const bool on = g_level > 0 && playing();
+    // new drops: light about 2 a second (up to 18 on the lens), heavy about 7 a second (up to 48)
+    if (on) {
+        const float rate = g_level == 1 ? 2.0f : 7.0f;
+        const std::size_t most = g_level == 1 ? 18 : 48;
+        float expect = rate * seconds;
+        while (expect > 0.0f && g_drops.size() < most) {
+            if (uniform(0.0f, 1.0f) < expect) {
+                Drop d;
+                d.x = uniform(0.02f, 0.98f);
+                d.y = uniform(0.0f, 0.85f);
+                const float size = uniform(0.0f, 1.0f);
+                d.r = 0.008f + size * size * 0.03f;          // mostly small, now and then a big one
+                d.age = 0.0f;
+                d.life = uniform(2.5f, 7.0f);
+                d.hold = uniform(0.3f, 2.5f);
+                d.speed = 0.05f + d.r * 6.0f;                  // big drops run faster
+                d.alpha = 0.0f;
+                g_drops.push_back(d);
+            }
+            expect -= 1.0f;
+        }
+    }
+    for (Drop &d : g_drops) {
+        d.age += seconds;
+        if (!on) d.life = std::min(d.life, d.age + 0.6f);   // nothing more falls: the lens clears quickly
+        if (d.age > d.hold) {
+            d.y += d.speed * seconds;
+            d.x += uniform(-0.002f, 0.002f);                   // runs down a little crookedly
+            d.r = std::max(0.006f, d.r - 0.004f * seconds);   // leaves water behind and gets smaller
+        }
+        const float in = std::min(1.0f, d.age / 0.12f), out = std::clamp((d.life - d.age) / 0.8f, 0.0f, 1.0f);
+        d.alpha = 0.85f * in * out;
+    }
+    g_drops.erase(std::remove_if(g_drops.begin(), g_drops.end(), [](const Drop &d) { return d.age >= d.life || d.y - d.r > 1.05f; }), g_drops.end());
+    float data[48 * 4];
+    unsigned n = 0;
+    for (const Drop &d : g_drops) {
+        if (n == 48) break;
+        data[n * 4 + 0] = d.x;
+        data[n * 4 + 1] = d.y;
+        data[n * 4 + 2] = d.r;
+        data[n * 4 + 3] = d.alpha;
+        ++n;
+    }
+    ps2::set_lens_drops(data, n);
+}
+
+}  // namespace lens_rain
