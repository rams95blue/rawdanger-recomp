+// PS2_GAME_PRINTF: a game's own debug printf, when a patch turns its body into "li v1,0x7D; syscall; jr ra" (rawdanger-recomp).
+// Retail builds compile printf to nothing; this prints what the developers' builds printed. Integer and string conversions only.
+void game_printf(Cpu &c) {
+    static const bool on = std::getenv("PS2_GAME_PRINTF") == nullptr || std::string(std::getenv("PS2_GAME_PRINTF")) != "0";
+    if (!on) { ret(c, 0); return; }
+    const int regs[] = {5, 6, 7, 8, 9, 10, 11};
+    std::size_t next = 0;
+    const auto take = [&]() -> std::uint64_t { return next < 7 ? c.r[regs[next++]].d[0] : 0; };
+    std::string out;
+    std::uint32_t f = arg(c, 0);
+    for (int guard = 0; guard < 4096; ++guard, ++f) {
+        const char ch = static_cast<char>(ld8(f));
+        if (!ch) break;
+        if (ch != '%') { out += ch; continue; }
+        std::string spec = "%";
+        char conv = 0;
+        while (++f, ++guard < 4096) {
+            conv = static_cast<char>(ld8(f));
+            if (!conv) break;
+            if (std::strchr("diouxXcspf%", conv)) break;
+            if (conv != 'l' && conv != 'h') spec += conv;
+        }
+        if (!conv) break;
+        char buf[512];
+        switch (conv) {
+        case '%': out += '%'; continue;
+        case 's': {
+            std::string str;
+            for (std::uint32_t a = static_cast<std::uint32_t>(take()), k = 0; k < 400; ++k) { const char x = static_cast<char>(ld8(a + k)); if (!x) break; str += x; }
+            std::snprintf(buf, sizeof buf, (spec + "s").c_str(), str.c_str());
+            break;
+        }
+        case 'c': std::snprintf(buf, sizeof buf, (spec + "c").c_str(), static_cast<int>(take())); break;
+        case 'f': std::snprintf(buf, sizeof buf, "%s", "<f>"); break;
+        case 'p': std::snprintf(buf, sizeof buf, "0x%08X", static_cast<unsigned>(take())); break;
+        case 'd': case 'i': std::snprintf(buf, sizeof buf, (spec + "d").c_str(), static_cast<int>(take())); break;
+        default: std::snprintf(buf, sizeof buf, (spec + conv).c_str(), static_cast<unsigned>(take())); break;
+        }
+        out += buf;
+    }
+    while (!out.empty() && (out.back() == '\n' || out.back() == '\r')) out.pop_back();
+    std::fprintf(stderr, "[game f%llu] %s\n", static_cast<unsigned long long>(frame_count()), out.c_str());
+    ret(c, 0);
+}
