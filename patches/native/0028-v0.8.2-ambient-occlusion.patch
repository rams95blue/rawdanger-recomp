+
+// rawdanger-recomp: ambient occlusion (v0.8.2), on the 3D picture before Raw Danger's colour filter. The game's depth is bigger
+// nearer, about 1 / distance, which is linear across the screen on a flat surface: so for pairs of points on opposite sides of a
+// pixel, their mean depth equals the pixel's on a floor or a wall, and is nearer in a crease, a corner, under a table or at a
+// foot on the floor: that is what darkens (not flat surfaces, and not edges of an object far in front). The pairs are as far
+// apart as the pixel's depth makes a fixed size in the world. prm: 0 frame, 1 width in pages, 2 3 width height, 4 depth, 5 its
+// format, 6 strength (0 ... 256), 7 radius (game pixels where the depth is 65536)
+fn ao_depth(x: i32, y: i32, w: u32, h: u32, k: u32) -> f32 {
+    let cx = u32(clamp(x, 0, i32(w) - 1));
+    let cy = u32(clamp(y, 0, i32(h) - 1));
+    return f32(read_sample(prm(5u), prm(4u), prm(1u), cx, cy, k));
+}
+
+@compute @workgroup_size(64)
+fn game_ao(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let i = gid.x + gid.y * 64u * 1024u;
+    let n = SCALE * SCALE;
+    let w = prm(2u);
+    let h = prm(3u);
+    if (i >= w * h * n) {
+        return;
+    }
+    let k = i % n;
+    let x = (i / n) % w;
+    let y = (i / n) / w;
+    let z0 = f32(read_sample(prm(5u), prm(4u), prm(1u), x, y, k));
+    if (z0 < 64.0) {
+        return;   // nothing drawn (sky, cleared)
+    }
+    let radius = clamp(f32(prm(7u)) * z0 / 65536.0, 1.5, 28.0);
+    let turn = fract(52.9829189 * fract(0.06711056 * f32(x) + 0.00583715 * f32(y))) * 3.14159265;
+    var occluded = 0.0;
+    for (var s = 0u; s < 6u; s = s + 1u) {
+        let a = turn + f32(s) * 0.52359878;
+        let r = radius * (0.5 + 0.5 * f32((s * 7u) % 6u) / 6.0);
+        let dx = i32(round(cos(a) * r));
+        let dy = i32(round(sin(a) * r));
+        let zp = ao_depth(i32(x) + dx, i32(y) + dy, w, h, k);
+        let zm = ao_depth(i32(x) - dx, i32(y) - dy, w, h, k);
+        if (zp <= 0.0 || zm <= 0.0) {
+            continue;
+        }
+        let crease = ((zp + zm) * 0.5 - z0) / z0;
+        let ahead = max(zp, zm) / z0 - 1.0;
+        occluded = occluded + smoothstep(0.004, 0.04, crease) * (1.0 - smoothstep(0.04, 0.15, ahead));
+    }
+    let ao = 1.0 - f32(prm(6u)) / 256.0 * clamp(occluded / 6.0 * 1.5, 0.0, 1.0);
+    let fl = locate(0u, prm(0u), prm(1u), x, y);
+    let c = load_at(fl, k);
+    let cr = u32(f32(c & 255u) * ao);
+    let cg = u32(f32((c >> 8u) & 255u) * ao);
+    let cb = u32(f32((c >> 16u) & 255u) * ao);
+    store(fl, k, cr | (cg << 8u) | (cb << 16u) | (c & 0xFF000000u));
+}
